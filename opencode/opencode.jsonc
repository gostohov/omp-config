{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "permission": {
    "*": "allow",
    "websearch": "deny"
  },
  "model": "ais-anthropic/qwen3.6:27b",
  "provider": {
    "ais-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "AIS Anthropic",
      "options": {
        "baseURL": "https://api.ais.mir/v1"
      },
      "models": {
        "qwen3.6:27b": {
          "name": "qwen3.6:27b",
          "limit": {
            "context": 131000,
            "output": 16384
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4,
    "preserve_recent_tokens": 24000,
    "reserved": 16384
  },
  "mcp": {
    "searxng": {
      "type": "remote",
      "url": "http://127.0.0.1:16445/mcp",
      "enabled": true,
      "timeout": 15000
    }
  }
}
